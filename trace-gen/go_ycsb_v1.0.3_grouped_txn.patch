+func TestRetryableTransactionConflictCodes(t *testing.T) {
+	for _, code := range []uint16{9007, 1213, 8022} {
+		if !isRetryableTransactionConflict(&mysql.MySQLError{Number: code}) {
+			t.Errorf("MySQL error %d should be retryable", code)
+		}
+	}
+	if isRetryableTransactionConflict(&mysql.MySQLError{Number: 1062}) {
+		t.Error("duplicate-key error should not be retryable")
+	}
+}
