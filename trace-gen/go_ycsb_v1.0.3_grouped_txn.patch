+func TestDSNWithParams(t *testing.T) {
+	const base = "root:@tcp(127.0.0.1:4000)/test"
+	tests := []struct {
+		name   string
+		params string
+		want   string
+	}{
+		{name: "empty", want: base},
+		{name: "plain", params: "tidb_txn_mode=optimistic", want: base + "?tidb_txn_mode=optimistic"},
+		{name: "leading question mark", params: "?tidb_txn_mode=optimistic", want: base + "?tidb_txn_mode=optimistic"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := dsnWithParams(base, tt.params); got != tt.want {
+				t.Fatalf("dsnWithParams() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
