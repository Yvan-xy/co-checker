+	if !reflect.DeepEqual(db.events, want) {
+		t.Fatalf("events = %v, want %v", db.events, want)
+	}
+}
+
+func TestWorkerRetriesConflictUntilTransactionCommits(t *testing.T) {
+	p := groupedProperties(2, 2)
+	p.Set(prop.RetryConflictedTransactions, "true")
+	db := &recordingDB{commitErrors: []error{
+		&mysql.MySQLError{Number: 9007, Message: "Write conflict"},
+	}}
+	workload := &recordingWorkload{db: db}
+	w := newWorker(p, 0, 1, workload, db)
