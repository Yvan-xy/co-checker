+func TestWorkerGroupedTransactionCommitsAfterKOperations(t *testing.T) {
+	p := groupedProperties(3, 3)
+	db := &recordingDB{}
+	workload := &recordingWorkload{db: db}
+	w := newWorker(p, 0, 1, workload, DbWrapper{DB: db})
+
+	w.run(context.Background())
+
+	want := []string{"begin", "operation", "operation", "operation", "commit"}
+	if !reflect.DeepEqual(db.events, want) {
+		t.Fatalf("events = %v, want %v", db.events, want)
+	}
+	if w.opsDone != 3 {
+		t.Fatalf("opsDone = %d, want 3 logical operations", w.opsDone)
+	}
+}
+
+func TestWorkerGroupedTransactionRollsBackOnOperationError(t *testing.T) {
+	p := groupedProperties(3, 3)
+	db := &recordingDB{}
