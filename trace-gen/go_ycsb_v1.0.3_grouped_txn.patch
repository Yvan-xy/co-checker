+func groupedProperties(operationCount int, operationsPerTransaction int) *properties.Properties {
+	p := properties.NewProperties()
+	p.Set(prop.DoTransactions, "true")
+	p.Set(prop.OperationCount, strconv.Itoa(operationCount))
+	p.Set(prop.OperationsPerTransaction, strconv.Itoa(operationsPerTransaction))
+	p.Set(prop.Silence, "true")
+	return p
+}
