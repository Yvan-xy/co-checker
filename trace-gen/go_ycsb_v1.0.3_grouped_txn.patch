+func TestWorkerDoesNotRetryUnexpectedGroupedError(t *testing.T) {
+	p := groupedProperties(2, 2)
+	p.Set(prop.RetryConflictedTransactions, "true")
+	db := &recordingDB{commitErr: errors.New("unexpected commit failure")}
+	workload := &recordingWorkload{db: db}
+	w := newWorker(p, 0, 1, workload, db)
+
+	w.run(context.Background())
+
+	if db.commitCalls != 1 {
+		t.Fatalf("commit calls = %d, want 1", db.commitCalls)
+	}
+	if w.opsDone != 2 {
+		t.Fatalf("opsDone = %d, want 2 attempted logical operations", w.opsDone)
+	}
+}
+
+func TestWorkerExplicitOneOperationUsesGroupedTransaction(t *testing.T) {
+	p := groupedProperties(1, 1)
+	db := &recordingDB{}
+	workload := &recordingWorkload{db: db}
+	w := newWorker(p, 0, 1, workload, db)
+
+	w.run(context.Background())
+
+	want := []string{"begin", "operation", "commit"}
+	if !reflect.DeepEqual(db.events, want) {
+		t.Fatalf("events = %v, want %v", db.events, want)
+	}
+}
+
+func TestWorkerUsesNormalizedOperationsPerTransaction(t *testing.T) {
+	p := groupedProperties(2, 2)
+	p.Set(prop.OperationsPerTransaction, " 2 ")
+	if err := validateTransactionGrouping(p); err != nil {
+		t.Fatalf("validate whitespace-padded operationspertransaction: %v", err)
+	}
+	db := &recordingDB{}
+	workload := &recordingWorkload{db: db}
+	w := newWorker(p, 0, 1, workload, db)
+
+	w.run(context.Background())
+
+	want := []string{"begin", "operation", "operation", "commit"}
+	if !reflect.DeepEqual(db.events, want) {
+		t.Fatalf("events = %v, want %v", db.events, want)
+	}
+}
+
+func TestWorkerAbsentOperationsPerTransactionUsesStockAutocommitPath(t *testing.T) {
+	p := properties.NewProperties()
+	p.Set(prop.DoTransactions, "true")
+	p.Set(prop.OperationCount, "1")
+	p.Set(prop.Silence, "true")
+	db := &recordingDB{}
+	workload := &recordingWorkload{db: db}
+	w := newWorker(p, 0, 1, workload, db)
+
+	w.run(context.Background())
+
+	want := []string{"operation"}
+	if !reflect.DeepEqual(db.events, want) {
+		t.Fatalf("events = %v, want %v", db.events, want)
+	}
+}
+
+func TestValidateTransactionGrouping(t *testing.T) {
+	if err := validateTransactionGrouping(groupedProperties(12, 3)); err != nil {
+		t.Fatalf("valid grouping rejected: %v", err)
+	}
+	if err := validateTransactionGrouping(groupedProperties(10, 3)); err == nil {
+		t.Fatal("non-divisible operationcount was accepted")
+	}
+	if err := validateTransactionGrouping(groupedProperties(10, 0)); err == nil {
+		t.Fatal("zero operationspertransaction was accepted")
+	}
+	invalid := groupedProperties(10, 1)
+	invalid.Set(prop.OperationsPerTransaction, "garbage")
+	if err := validateTransactionGrouping(invalid); err == nil {
+		t.Fatal("nonnumeric operationspertransaction was accepted")
+	}
+}
+
+func TestGroupedOperationCountIsDistributedAsWholeTransactions(t *testing.T) {
+	p := groupedProperties(10, 2)
+	db := &recordingDB{}
+	workload := &recordingWorkload{db: db}
+
+	var total int64
+	for threadID := 0; threadID < 3; threadID++ {
+		w := newWorker(p, threadID, 3, workload, db)
+		if w.opCount%2 != 0 {
+			t.Fatalf("thread %d got %d logical operations", threadID, w.opCount)
+		}
+		total += w.opCount
+	}
+	if total != 10 {
+		t.Fatalf("distributed operationcount = %d, want 10", total)
+	}
+}
+
+func TestAnalyzeAfterLoadCanBeDisabled(t *testing.T) {
+	tests := []struct {
+		name          string
+		setProperty   bool
+		propertyValue string
+		wantCalls     int
+	}{
+		{name: "default enabled", wantCalls: 1},
+		{name: "disabled", setProperty: true, propertyValue: "false", wantCalls: 0},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			p := properties.NewProperties()
+			p.Set(prop.DoTransactions, "false")
+			p.Set(prop.RecordCount, "1")
+			p.Set(prop.ThreadCount, "1")
+			if tt.setProperty {
+				p.Set(prop.AnalyzeAfterLoad, tt.propertyValue)
+			}
+			db := &recordingDB{}
+			workload := &recordingWorkload{db: db}
+
+			NewClient(p, workload, db).Run(context.Background())
+
+			if db.analyzeCalls != tt.wantCalls {
+				t.Fatalf("Analyze calls = %d, want %d", db.analyzeCalls, tt.wantCalls)
+			}
+		})
+	}
+}
