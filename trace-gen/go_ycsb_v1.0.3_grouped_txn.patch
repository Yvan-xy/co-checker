+type recordingDB struct {
+	events       []string
+	commitErr    error
+	commitErrors []error
+	commitCalls  int
+	analyzeCalls int
+}
+
+func (db *recordingDB) Close() error { return nil }
+
+func (db *recordingDB) InitThread(ctx context.Context, _ int, _ int) context.Context {
+	return ctx
+}
+
+func (db *recordingDB) CleanupThread(context.Context) {}
+
+func (db *recordingDB) Read(context.Context, string, string, []string) (map[string][]byte, error) {
+	return nil, nil
+}
+
+func (db *recordingDB) Scan(context.Context, string, string, int, []string) ([]map[string][]byte, error) {
+	return nil, nil
+}
+
+func (db *recordingDB) Update(context.Context, string, string, map[string][]byte) error {
+	return nil
+}
+
+func (db *recordingDB) Insert(context.Context, string, string, map[string][]byte) error {
+	return nil
+}
+
+func (db *recordingDB) Delete(context.Context, string, string) error { return nil }
+
+func (db *recordingDB) BeginTransaction(context.Context) error {
+	db.events = append(db.events, "begin")
+	return nil
+}
+
+func (db *recordingDB) CommitTransaction(context.Context) error {
+	db.events = append(db.events, "commit")
+	db.commitCalls++
+	if len(db.commitErrors) > 0 {
+		err := db.commitErrors[0]
+		db.commitErrors = db.commitErrors[1:]
+		return err
+	}
+	return db.commitErr
+}
+
+func (db *recordingDB) RollbackTransaction(context.Context) error {
+	db.events = append(db.events, "rollback")
+	return nil
+}
+
+func (db *recordingDB) Analyze(context.Context, string) error {
+	db.analyzeCalls++
+	return nil
+}
+
+type recordingWorkload struct {
+	db     *recordingDB
+	calls  int
+	failAt int
+}
+
+func (w *recordingWorkload) Close() error { return nil }
+
+func (w *recordingWorkload) InitThread(ctx context.Context, _ int, _ int) context.Context {
+	return ctx
+}
+
+func (w *recordingWorkload) CleanupThread(context.Context) {}
+
+func (w *recordingWorkload) Load(context.Context, ycsb.DB, int64) error { return nil }
+
+func (w *recordingWorkload) DoInsert(context.Context, ycsb.DB) error { return nil }
+
+func (w *recordingWorkload) DoBatchInsert(context.Context, int, ycsb.DB) error { return nil }
+
+func (w *recordingWorkload) DoTransaction(context.Context, ycsb.DB) error {
+	w.calls++
+	w.db.events = append(w.db.events, "operation")
+	if w.calls == w.failAt {
+		return errors.New("injected operation failure")
+	}
+	return nil
+}
+
+func (w *recordingWorkload) DoBatchTransaction(context.Context, int, ycsb.DB) error {
+	return nil
+}
