+func validateTransactionGrouping(p *properties.Properties) error {
+	if !p.GetBool(prop.DoTransactions, true) {
+		return nil
+	}
+	rawOperationsPerTransaction, ok := p.Get(prop.OperationsPerTransaction)
+	if !ok {
+		return nil
+	}
+
+	operationsPerTransaction, err := strconv.Atoi(strings.TrimSpace(rawOperationsPerTransaction))
+	if err != nil {
+		return fmt.Errorf("invalid %s %q: %w", prop.OperationsPerTransaction, rawOperationsPerTransaction, err)
+	}
+	if _, _, err := p.Set(prop.OperationsPerTransaction, strconv.Itoa(operationsPerTransaction)); err != nil {
+		return fmt.Errorf("normalize %s: %w", prop.OperationsPerTransaction, err)
+	}
+	if operationsPerTransaction < 1 {
+		return fmt.Errorf("%s must be at least 1, got %d", prop.OperationsPerTransaction, operationsPerTransaction)
+	}
+	if batchSize := p.GetInt(prop.BatchSize, prop.DefaultBatchSize); batchSize > 1 {
+		return fmt.Errorf("%s cannot be combined with %s greater than 1", prop.OperationsPerTransaction, prop.BatchSize)
+	}
+
+	operationCount := p.GetInt64(prop.OperationCount, 0)
+	if operationCount < 0 {
+		return fmt.Errorf("%s must not be negative, got %d", prop.OperationCount, operationCount)
+	}
+	if operationCount != 0 && operationCount%int64(operationsPerTransaction) != 0 {
+		return fmt.Errorf("%s (%d) must be divisible by %s (%d)", prop.OperationCount, operationCount,
+			prop.OperationsPerTransaction, operationsPerTransaction)
+	}
+	return nil
+}
