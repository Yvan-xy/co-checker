+func TestScrambledZipfianUsesActualRangeForEveryTheta(t *testing.T) {
+	const (
+		min = int64(17)
+		max = int64(116)
+	)
+
+	for _, theta := range []float64{0.8, ZipfianConstant} {
+		t.Run(fmt.Sprint(theta), func(t *testing.T) {
+			g := NewScrambledZipfian(min, max, theta)
+			if g.gen.items != max-min+1 {
+				t.Fatalf("underlying item count = %d, want %d", g.gen.items, max-min+1)
+			}
+			if g.gen.theta != theta {
+				t.Fatalf("theta = %v, want %v", g.gen.theta, theta)
+			}
+
+			r := rand.New(rand.NewSource(1))
+			for i := 0; i < 1000; i++ {
+				value := g.Next(r)
+				if value < min || value > max {
+					t.Fatalf("value %d is outside [%d, %d]", value, min, max)
+				}
+			}
+		})
+	}
+}
