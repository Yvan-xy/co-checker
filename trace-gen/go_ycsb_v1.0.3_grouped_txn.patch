+func transactionDB(db ycsb.DB) (ycsb.TransactionDB, bool) {
+	txDB, ok := db.(ycsb.TransactionDB)
+	if ok {
+		return txDB, true
+	}
+	if wrapper, ok := db.(DbWrapper); ok {
+		txDB, ok = wrapper.DB.(ycsb.TransactionDB)
+		return txDB, ok
+	}
+	return nil, false
+}
+
+func (w *worker) runGroupedTransaction(ctx context.Context) error {
+	db, ok := transactionDB(w.workDB)
+	if !ok {
+		return fmt.Errorf("database %T does not support grouped transactions", w.workDB)
+	}
+	if err := db.BeginTransaction(ctx); err != nil {
+		return err
+	}
+
+	for i := 0; i < w.operationsPerTransaction; i++ {
+		if err := w.workload.DoTransaction(ctx, w.workDB); err != nil {
+			if rollbackErr := db.RollbackTransaction(ctx); rollbackErr != nil {
+				return fmt.Errorf("operation failed: %w; rollback failed: %v", err, rollbackErr)
+			}
+			return err
+		}
+	}
+
+	if err := db.CommitTransaction(ctx); err != nil {
+		if rollbackErr := db.RollbackTransaction(ctx); rollbackErr != nil {
+			return fmt.Errorf("commit failed: %w; rollback failed: %v", err, rollbackErr)
+		}
+		return err
+	}
+	return nil
+}
+
+func isRetryableTransactionConflict(err error) bool {
+	var mysqlErr *mysql.MySQLError
+	if !errors.As(err, &mysqlErr) {
+		return false
+	}
+	return mysqlErr.Number == 9007 || mysqlErr.Number == 1213 || mysqlErr.Number == 8022
+}
