+// OperationSummary is the machine-readable latency summary for one label.
+type OperationSummary struct {
+	Count      int64 `json:"count"`
+	P50Micros  int64 `json:"p50_us"`
+	P95Micros  int64 `json:"p95_us"`
+	P99Micros  int64 `json:"p99_us"`
+	P999Micros int64 `json:"p99_9_us"`
+}
+
+func percentile(sorted []int64, percentile float64) int64 {
+	if len(sorted) == 0 {
+		return 0
+	}
+	index := int(float64(len(sorted)-1) * percentile / 100.0)
+	return sorted[index]
+}
+
+// Snapshot returns stable operation counts and required percentiles.
+func Snapshot() map[string]OperationSummary {
+	result := make(map[string]OperationSummary)
+	if globalMeasure == nil {
+		return result
+	}
+	globalMeasure.RLock()
+	defer globalMeasure.RUnlock()
+	switch measurer := globalMeasure.measurer.(type) {
+	case *histograms:
+		for operation, h := range measurer.histograms {
+			result[operation] = OperationSummary{
+				Count:      h.hist.TotalCount(),
+				P50Micros:  h.hist.ValueAtPercentile(50),
+				P95Micros:  h.hist.ValueAtPercentile(95),
+				P99Micros:  h.hist.ValueAtPercentile(99),
+				P999Micros: h.hist.ValueAtPercentile(99.9),
+			}
+		}
+	case *csvs:
+		for operation, entries := range measurer.opCsv {
+			latencies := make([]int64, len(entries))
+			for i := range entries {
+				latencies[i] = entries[i].latencyUs
+			}
+			sort.Slice(latencies, func(i, j int) bool { return latencies[i] < latencies[j] })
+			result[operation] = OperationSummary{
+				Count:      int64(len(latencies)),
+				P50Micros:  percentile(latencies, 50),
+				P95Micros:  percentile(latencies, 95),
+				P99Micros:  percentile(latencies, 99),
+				P999Micros: percentile(latencies, 99.9),
+			}
+		}
+	}
+	return result
 }
 
