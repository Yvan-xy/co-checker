+	}
+}
+
+func TestThreadSeedsAreStableAndIndependent(t *testing.T) {
+	run := func() map[int]int64 {
+		p := clientProperties(t, true, 4, 2, true)
+		workload := &fakeWorkload{}
+		result, err := NewClient(p, workload, &fakeDB{}).Run(context.Background())
