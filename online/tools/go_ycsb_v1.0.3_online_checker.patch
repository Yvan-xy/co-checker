diff --git a/cmd/go-ycsb/result.go b/cmd/go-ycsb/result.go
new file mode 100644
index 0000000000000000000000000000000000000000..1b6f01b69fbf70a0825285f96c162bddc0483940
--- /dev/null
+++ b/cmd/go-ycsb/result.go
@@ -0,0 +1,137 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+
+	"github.com/magiconair/properties"
+	"github.com/pingcap/go-ycsb/pkg/client"
+	"github.com/pingcap/go-ycsb/pkg/measurement"
+	"github.com/pingcap/go-ycsb/pkg/prop"
+	"github.com/pingcap/go-ycsb/pkg/util"
+)
+
+const (
+	resultFormatVersion = "go-ycsb-online-result-v1"
+	clientIdentity      = "go-ycsb-v1.0.3-online-checker-v1"
+	baseCommit          = "f030f9942393a8febbf4365c2d582711723159f5"
+	patchIdentity       = "co-checker-go-ycsb-online-v1"
+)
+
+type structuredResult struct {
+	FormatVersion      string                                  `json:"format_version"`
+	ClientIdentity     string                                  `json:"client_identity"`
+	BaseCommit         string                                  `json:"base_commit"`
+	PatchIdentity      string                                  `json:"patch_identity"`
+	Command            string                                  `json:"command"`
+	MasterSeed         int64                                   `json:"master_seed"`
+	SeedDerivation     string                                  `json:"seed_derivation"`
+	PropertiesSHA256   string                                  `json:"properties_sha256"`
+	Requested          int64                                   `json:"requested"`
+	Attempted          int64                                   `json:"attempted"`
+	Successful         int64                                   `json:"successful"`
+	Failed             int64                                   `json:"failed"`
+	StartedUnixNano    int64                                   `json:"started_unix_ns"`
+	EndedUnixNano      int64                                   `json:"ended_unix_ns"`
+	MonotonicStartNano int64                                   `json:"monotonic_start_ns"`
+	MonotonicEndNano   int64                                   `json:"monotonic_end_ns"`
+	ElapsedNano        int64                                   `json:"elapsed_ns"`
+	ErrorClasses       map[string]int64                        `json:"error_classes"`
+	ErrorMessage       string                                  `json:"error_message,omitempty"`
+	Measurements       map[string]measurement.OperationSummary `json:"measurements"`
+}
+
+func digestProperties(p *properties.Properties) string {
+	if p == nil {
+		return ""
+	}
+	values := p.Map()
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	hash := sha256.New()
+	for _, key := range keys {
+		hash.Write([]byte(strconv.Itoa(len(key))))
+		hash.Write([]byte{':'})
+		hash.Write([]byte(key))
+		hash.Write([]byte{'='})
+		hash.Write([]byte(strconv.Itoa(len(values[key]))))
+		hash.Write([]byte{':'})
+		hash.Write([]byte(values[key]))
+		hash.Write([]byte{'\n'})
+	}
+	return hex.EncodeToString(hash.Sum(nil))
+}
+
+func makeStructuredResult(command string, p *properties.Properties, result client.Result, startUnix int64, endUnix int64, elapsed int64) structuredResult {
+	return structuredResult{
+		FormatVersion:      resultFormatVersion,
+		ClientIdentity:     clientIdentity,
+		BaseCommit:         baseCommit,
+		PatchIdentity:      patchIdentity,
+		Command:            command,
+		MasterSeed:         p.GetInt64(prop.RandomSeed, 0),
+		SeedDerivation:     util.SeedDerivationVersion,
+		PropertiesSHA256:   digestProperties(p),
+		Requested:          result.Requested,
+		Attempted:          result.Attempted,
+		Successful:         result.Successful,
+		Failed:             result.Failed,
+		StartedUnixNano:    startUnix,
+		EndedUnixNano:      endUnix,
+		MonotonicStartNano: 0,
+		MonotonicEndNano:   elapsed,
+		ElapsedNano:        elapsed,
+		ErrorClasses:       result.ErrorClasses,
+		ErrorMessage:       result.ErrorMessage,
+		Measurements:       measurement.Snapshot(),
+	}
+}
+
+func writeStructuredResult(path string, result structuredResult) error {
+	if path == "" {
+		return nil
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return fmt.Errorf("create result directory: %w", err)
+	}
+	temporary := path + ".tmp-" + strconv.Itoa(os.Getpid())
+	file, err := os.OpenFile(temporary, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o644)
+	if err != nil {
+		return fmt.Errorf("create temporary result: %w", err)
+	}
+	removeTemporary := true
+	defer func() {
+		if removeTemporary {
+			_ = os.Remove(temporary)
+		}
+	}()
+	encoder := json.NewEncoder(file)
+	encoder.SetIndent("", "  ")
+	if err = encoder.Encode(result); err == nil {
+		err = file.Sync()
+	}
+	closeErr := file.Close()
+	if err != nil {
+		return fmt.Errorf("write temporary result: %w", err)
+	}
+	if closeErr != nil {
+		return fmt.Errorf("close temporary result: %w", closeErr)
+	}
+	if err = os.Link(temporary, path); err != nil {
+		return fmt.Errorf("publish result without overwrite: %w", err)
+	}
+	if err = os.Remove(temporary); err != nil {
+		return fmt.Errorf("remove temporary result: %w", err)
+	}
+	removeTemporary = false
+	return nil
+}
