+
+type fakeDB struct {
+	analyzeErr   error
+	analyzeCalls atomic.Int64
+	initPanic    bool
+	cleanupPanic bool
+}
+
+func (*fakeDB) Close() error { return nil }
+func (db *fakeDB) InitThread(ctx context.Context, _ int, _ int) context.Context {
+	if db.initPanic {
+		panic("init failed")
+	}
+	return ctx
+}
+func (db *fakeDB) CleanupThread(context.Context) {
+	if db.cleanupPanic {
+		panic("cleanup failed")
+	}
+}
+func (*fakeDB) Read(context.Context, string, string, []string) (map[string][]byte, error) {
+	return map[string][]byte{"field0": []byte("value")}, nil
+}
+func (*fakeDB) Scan(context.Context, string, string, int, []string) ([]map[string][]byte, error) {
+	return nil, nil
+}
+func (*fakeDB) Update(context.Context, string, string, map[string][]byte) error { return nil }
+func (*fakeDB) Insert(context.Context, string, string, map[string][]byte) error { return nil }
+func (*fakeDB) Delete(context.Context, string, string) error                    { return nil }
+func (db *fakeDB) Analyze(context.Context, string) error {
+	db.analyzeCalls.Add(1)
+	return db.analyzeErr
+}
+
+type fakeWorkload struct {
+	calls        atomic.Int64
+	failAt       int64
+	initPanic    bool
+	cleanupPanic bool
+	seedMu       sync.Mutex
+	seeds        map[int]int64
+}
+
+func (*fakeWorkload) Close() error { return nil }
+func (w *fakeWorkload) InitThread(ctx context.Context, threadID int, _ int) context.Context {
+	if w.initPanic {
+		panic("init failed")
+	}
+	seed, ok := ycsb.ThreadSeed(ctx)
+	if ok {
+		w.seedMu.Lock()
+		if w.seeds == nil {
+			w.seeds = make(map[int]int64)
+		}
+		w.seeds[threadID] = seed
+		w.seedMu.Unlock()
+	}
+	return ctx
+}
+func (w *fakeWorkload) CleanupThread(context.Context) {
+	if w.cleanupPanic {
+		panic("cleanup failed")
+	}
+}
+func (*fakeWorkload) Load(context.Context, ycsb.DB, int64) error { return nil }
+func (w *fakeWorkload) operation() error {
+	call := w.calls.Add(1)
+	if w.failAt > 0 && call == w.failAt {
+		return errors.New("injected operation failure")
+	}
+	return nil
+}
+func (w *fakeWorkload) DoInsert(context.Context, ycsb.DB) error      { return w.operation() }
+func (w *fakeWorkload) DoTransaction(context.Context, ycsb.DB) error { return w.operation() }
+func (w *fakeWorkload) DoBatchInsert(context.Context, int, ycsb.DB) error {
+	return w.operation()
+}
+func (w *fakeWorkload) DoBatchTransaction(context.Context, int, ycsb.DB) error {
+	return w.operation()
+}
