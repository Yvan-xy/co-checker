+func TestStrictRowValidation(t *testing.T) {
+	if err := validateStrictRowCount(true, true, "point read", 0, 1); err == nil {
+		t.Fatal("missing point row was accepted")
+	}
+	if err := validateStrictRowCount(true, true, "point read", 1, 1); err != nil {
+		t.Fatal(err)
+	}
+	if err := validateStrictRowCount(true, false, "scan", 3, 10); err != nil {
+		t.Fatal("strict scans may return fewer rows than requested")
+	}
+	if err := validateAffectedRows(driver.RowsAffected(0), 1); err == nil {
