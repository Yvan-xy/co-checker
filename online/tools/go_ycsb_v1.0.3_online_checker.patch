@@ -0,0 +1,46 @@
+package generator
+
+import (
+	"math/rand"
+	"reflect"
+	"testing"
+)
+
+func sequence(generator interface{ Next(*rand.Rand) int64 }, seed int64, count int) []int64 {
+	rng := rand.New(rand.NewSource(seed))
+	values := make([]int64, count)
+	for i := range values {
+		values[i] = generator.Next(rng)
+	}
+	return values
+}
+
+func TestDeterministicUniformZipfianLatestAndScanSequences(t *testing.T) {
+	const seed = int64(81923)
+	tests := []struct {
+		name string
+		new  func() interface{ Next(*rand.Rand) int64 }
+	}{
+		{name: "uniform", new: func() interface{ Next(*rand.Rand) int64 } { return NewUniform(0, 999) }},
+		{name: "zipfian", new: func() interface{ Next(*rand.Rand) int64 } {
+			return NewScrambledZipfian(0, 999, ZipfianConstant)
+		}},
+		{name: "latest", new: func() interface{ Next(*rand.Rand) int64 } {
+			return NewSkewedLatest(NewAcknowledgedCounter(1000))
+		}},
+		{name: "scan_length", new: func() interface{ Next(*rand.Rand) int64 } { return NewUniform(1, 100) }},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			first := sequence(test.new(), seed, 64)
+			second := sequence(test.new(), seed, 64)
+			third := sequence(test.new(), seed+1, 64)
+			if !reflect.DeepEqual(first, second) {
+				t.Fatalf("same seed produced different sequences: %v != %v", first, second)
+			}
+			if reflect.DeepEqual(first, third) {
+				t.Fatalf("different seeds produced the same sequence: %v", first)
+			}
+		})
+	}
