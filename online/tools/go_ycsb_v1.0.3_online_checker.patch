+
+func TestInitializationAndCleanupPanicsBecomeErrors(t *testing.T) {
+	p := clientProperties(t, true, 3, 1, true)
+	result, err := NewClient(p, &fakeWorkload{initPanic: true}, &fakeDB{}).Run(context.Background())
