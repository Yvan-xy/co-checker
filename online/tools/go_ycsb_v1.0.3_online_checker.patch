+func deterministicProperties(t *testing.T, distribution string, scanOnly bool) *properties.Properties {
+	t.Helper()
+	p := properties.NewProperties()
+	values := map[string]string{
+		prop.RecordCount:         "1000",
+		prop.OperationCount:      "64",
+		prop.FieldCount:          "3",
+		prop.FieldLength:         "16",
+		prop.RequestDistribution: distribution,
+		prop.ReadProportion:      "0",
+		prop.UpdateProportion:    "1",
+		prop.ScanProportion:      "0",
+		prop.MinScanLength:       "1",
+		prop.MaxScanLength:       "100",
+	}
+	if scanOnly {
+		values[prop.UpdateProportion] = "0"
+		values[prop.ScanProportion] = "1"
+	}
+	for key, value := range values {
+		if _, _, err := p.Set(key, value); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return p
+}
