+package util
+
+const (
+	// SeedDerivationVersion identifies the stable per-thread seed derivation.
+	SeedDerivationVersion = "splitmix64-v1"
+	// WorkloadSeedStream separates workload randomness from pacing jitter.
+	WorkloadSeedStream uint64 = 0x776f726b6c6f6164
+	// ThrottleSeedStream separates pacing jitter from workload randomness.
+	ThrottleSeedStream uint64 = 0x7468726f74746c65
+)
+
+// DeriveSeed deterministically derives an independent nonzero seed.
+func DeriveSeed(master int64, threadID int, stream uint64) int64 {
+	x := uint64(master) ^ stream ^ (uint64(threadID+1) * 0x9e3779b97f4a7c15)
+	x += 0x9e3779b97f4a7c15
+	x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9
+	x = (x ^ (x >> 27)) * 0x94d049bb133111eb
+	x ^= x >> 31
+	seed := int64(x & ((uint64(1) << 63) - 1))
+	if seed == 0 {
+		return 1
+	}
+	return seed
+}
