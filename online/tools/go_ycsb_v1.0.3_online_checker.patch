+func TestDSNParametersSingleAndMultipleInstances(t *testing.T) {
+	raw := "transaction_isolation=%27REPEATABLE-READ%27&tidb_txn_mode=%27OPTIMISTIC%27&tidb_enable_1pc=0"
+	params, err := parseParams(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	check := func(dsn string) {
+		config, err := drivermysql.ParseDSN(dsn)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if config.Params["transaction_isolation"] != "'REPEATABLE-READ'" ||
+			config.Params["tidb_txn_mode"] != "'OPTIMISTIC'" || config.Params["tidb_enable_1pc"] != "0" {
+			t.Fatalf("parameters missing from DSN %q: %v", dsn, config.Params)
+		}
+	}
+	check(formatDSN("127.0.0.1:4000", "root", "", "ycsb", params))
+	db, err := openTiDBInstances([]string{"127.0.0.1:4000", "127.0.0.1:4001"}, "root", "", "ycsb", params)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	mux, ok := db.Driver().(*muxDriver)
+	if !ok || len(mux.instances) != 2 {
+		t.Fatalf("unexpected mux driver: %#v", db.Driver())
+	}
+	for _, dsn := range mux.instances {
+		check(dsn)
+	}
+	changed := map[string]string{
+		"transaction_isolation": "'REPEATABLE-READ'",
+		"tidb_txn_mode":         "'OPTIMISTIC'",
+		"tidb_enable_1pc":       "1",
+	}
+	changedDB, err := openTiDBInstances([]string{"127.0.0.1:4000", "127.0.0.1:4001"}, "root", "", "ycsb", changed)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer changedDB.Close()
+	changedMux := changedDB.Driver().(*muxDriver)
+	changedConfig, err := drivermysql.ParseDSN(changedMux.instances[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if changedConfig.Params["tidb_enable_1pc"] != "1" {
+		t.Fatalf("mux registration hash ignored parameters: %v", changedConfig.Params)
+	}
+}
+
+func TestCreateTableCanBeDisabled(t *testing.T) {
+	p := properties.NewProperties()
+	_, _, _ = p.Set(mysqlCreateTable, "false")
+	_, _, _ = p.Set(mysqlParams, "tidb_txn_mode=%27OPTIMISTIC%27")
+	db, err := (mysqlCreator{name: "tidb"}).Create(p)
