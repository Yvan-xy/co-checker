+func TestStructuredResultIsAtomicAndRefusesOverwrite(t *testing.T) {
+	p := properties.NewProperties()
+	_, _, _ = p.Set(prop.RandomSeed, "17")
+	measurement.InitMeasure(p)
+	result := client.Result{
+		Requested: 3, Attempted: 3, Successful: 2, Failed: 1,
+		ErrorClasses: map[string]int64{"operation": 1},
+	}
+	structured := makeStructuredResult("run", p, result, 100, 130, 30)
+	path := filepath.Join(t.TempDir(), "result.json")
+	if err := writeStructuredResult(path, structured); err != nil {
+		t.Fatal(err)
+	}
+	original, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded structuredResult
+	if err := json.Unmarshal(original, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded.FormatVersion != resultFormatVersion || decoded.BaseCommit != baseCommit ||
+		decoded.Requested != 3 || decoded.Successful+decoded.Failed != decoded.Requested ||
+		decoded.MasterSeed != 17 || decoded.ElapsedNano != 30 {
+		t.Fatalf("unexpected structured result: %+v", decoded)
+	}
+	if err := writeStructuredResult(path, structured); err == nil {
+		t.Fatal("existing result was overwritten")
+	}
+	after, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(after) != string(original) {
+		t.Fatal("existing result changed after overwrite refusal")
+	}
+}
+
+func TestPropertiesDigestIsCanonical(t *testing.T) {
+	first := properties.NewProperties()
+	_, _, _ = first.Set("b", "two")
+	_, _, _ = first.Set("a", "one")
+	second := properties.NewProperties()
+	_, _, _ = second.Set("a", "one")
+	_, _, _ = second.Set("b", "two")
+	if digestProperties(first) != digestProperties(second) {
+		t.Fatal("property insertion order changed the digest")
+	}
+	_, _, _ = second.Set("b", "changed")
+	if digestProperties(first) == digestProperties(second) {
+		t.Fatal("property value change did not change the digest")
+	}
+}
+
+func TestRunMainReturnsErrorAndWritesInitializationResult(t *testing.T) {
+	propertyFiles = nil
+	propertyValues = nil
+	tableName = ""
+	path := filepath.Join(t.TempDir(), "failure.json")
+	err := runMain([]string{
+		"run", "definitely-unregistered-db",
+		"-p", "strict=true",
+		"-p", "randomseed=29",
+		"-p", "operationcount=1",
+		"-p", "result.path=" + path,
+	})
+	if err == nil {
+		t.Fatal("command failure returned zero status")
+	}
+	content, readErr := os.ReadFile(path)
+	if readErr != nil {
+		t.Fatal(readErr)
+	}
+	var result structuredResult
+	if err := json.Unmarshal(content, &result); err != nil {
+		t.Fatal(err)
+	}
+	if result.ErrorClasses["initialization"] != 1 || result.Requested != 1 || result.Failed != 1 {
+		t.Fatalf("initialization failure was not conserved: %+v", result)
+	}
+}
