+type traceDB struct {
+	trace   []string
+	readErr error
+}
+
+func (*traceDB) Close() error                                             { return nil }
+func (*traceDB) InitThread(ctx context.Context, _, _ int) context.Context { return ctx }
+func (*traceDB) CleanupThread(context.Context)                            {}
+func (db *traceDB) Read(context.Context, string, string, []string) (map[string][]byte, error) {
+	if db.readErr != nil {
+		return nil, db.readErr
+	}
+	return map[string][]byte{"field0": []byte("value")}, nil
+}
+func (db *traceDB) Scan(_ context.Context, _ string, key string, count int, _ []string) ([]map[string][]byte, error) {
+	db.trace = append(db.trace, fmt.Sprintf("S:%s:%d", key, count))
+	return nil, nil
+}
+func (db *traceDB) Update(_ context.Context, _ string, key string, values map[string][]byte) error {
+	fields := make([]string, 0, len(values))
+	for field := range values {
+		fields = append(fields, field)
+	}
+	sort.Strings(fields)
+	parts := []string{"U", key}
+	for _, field := range fields {
+		parts = append(parts, field+"="+hex.EncodeToString(values[field]))
+	}
+	db.trace = append(db.trace, strings.Join(parts, ":"))
+	return nil
+}
+func (*traceDB) Insert(context.Context, string, string, map[string][]byte) error { return nil }
+func (*traceDB) Delete(context.Context, string, string) error                    { return nil }
