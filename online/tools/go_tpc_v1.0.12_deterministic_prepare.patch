new file mode 100644
index 0000000..381e77a
--- /dev/null
+++ b/pkg/sink/preparation_manifest.go
@@ -0,0 +1,154 @@
+package sink
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"hash"
+	"os"
+	"path/filepath"
+	"sync"
+)
+
+type preparationTransaction struct {
+	Sequence  uint64 `json:"sequence"`
+	Rows      int    `json:"logical_write_count"`
+	SQLBytes  int    `json:"sql_bytes"`
+	SQLSHA256 string `json:"sql_sha256"`
+}
+
+type preparationManifest struct {
+	FormatVersion         int                      `json:"format_version"`
+	Generator             string                   `json:"generator"`
+	Seed                  int64                    `json:"seed"`
+	LoadTime              string                   `json:"load_time"`
+	WorkerCount           int                      `json:"worker_count"`
+	TransactionCount      uint64                   `json:"transaction_count"`
+	LogicalWriteCount     uint64                   `json:"logical_write_count"`
+	OrderedManifestSHA256 string                   `json:"ordered_manifest_sha256"`
+	Transactions          []preparationTransaction `json:"transactions"`
+}
+
+type preparationRecorder struct {
+	mu       sync.Mutex
+	path     string
+	manifest preparationManifest
+	digest   hash.Hash
+	closed   bool
+}
+
+var activePreparation struct {
+	sync.Mutex
+	recorder *preparationRecorder
+}
+
+// StartPreparationManifest enables ordered recording for a single-worker
+// preparation run. Each successful SQLSink flush is one autocommit transaction;
+// its exact SQL bytes frame the manifest hash and contain every logical row
+// write in execution order.
+func StartPreparationManifest(path string, seed int64, loadTime string, workers int) (func() error, error) {
+	if path == "" || seed == 0 || loadTime == "" || workers != 1 {
+		return nil, fmt.Errorf("manifest path, nonzero seed, fixed load time, and one worker are required")
+	}
+	activePreparation.Lock()
+	defer activePreparation.Unlock()
+	if activePreparation.recorder != nil {
+		return nil, fmt.Errorf("preparation manifest is already active")
+	}
+	recorder := &preparationRecorder{
+		path:   path,
+		digest: sha256.New(),
+		manifest: preparationManifest{
+			FormatVersion: 1,
+			Generator:     "github.com/pingcap/go-tpc@v1.0.12+co-checker-deterministic-prepare-v1",
+			Seed:          seed,
+			LoadTime:      loadTime,
+			WorkerCount:   workers,
+			Transactions:  make([]preparationTransaction, 0, 1024),
+		},
+	}
+	activePreparation.recorder = recorder
+	return func() error { return recorder.finish() }, nil
+}
+
+func recordPreparationStatement(statement string, rows int) error {
+	activePreparation.Lock()
+	recorder := activePreparation.recorder
+	activePreparation.Unlock()
+	if recorder == nil {
+		return nil
+	}
+	return recorder.record(statement, rows)
+}
+
+func (r *preparationRecorder) record(statement string, rows int) error {
+	if rows <= 0 {
+		return fmt.Errorf("preparation statement has no logical writes")
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return fmt.Errorf("preparation manifest is closed")
+	}
+	sequence := uint64(len(r.manifest.Transactions) + 1)
+	statementBytes := []byte(statement)
+	statementDigest := sha256.Sum256(statementBytes)
+	var frame [24]byte
+	binary.LittleEndian.PutUint64(frame[0:8], sequence)
+	binary.LittleEndian.PutUint64(frame[8:16], uint64(rows))
+	binary.LittleEndian.PutUint64(frame[16:24], uint64(len(statementBytes)))
+	_, _ = r.digest.Write(frame[:])
+	_, _ = r.digest.Write(statementBytes)
+	r.manifest.Transactions = append(r.manifest.Transactions, preparationTransaction{
+		Sequence:  sequence,
+		Rows:      rows,
+		SQLBytes:  len(statementBytes),
+		SQLSHA256: hex.EncodeToString(statementDigest[:]),
+	})
+	r.manifest.TransactionCount++
+	r.manifest.LogicalWriteCount += uint64(rows)
+	return nil
+}
+
+func (r *preparationRecorder) finish() error {
+	r.mu.Lock()
+	if r.closed {
+		r.mu.Unlock()
+		return nil
+	}
+	r.closed = true
+	r.manifest.OrderedManifestSHA256 = hex.EncodeToString(r.digest.Sum(nil))
+	contents, err := json.MarshalIndent(r.manifest, "", "  ")
+	r.mu.Unlock()
+	activePreparation.Lock()
+	if activePreparation.recorder == r {
+		activePreparation.recorder = nil
+	}
+	activePreparation.Unlock()
+	if err != nil {
+		return err
+	}
+	contents = append(contents, '\n')
+	directory := filepath.Dir(r.path)
+	if err := os.MkdirAll(directory, 0755); err != nil {
+		return err
+	}
+	temporary, err := os.CreateTemp(directory, ".preparation-manifest-*.tmp")
+	if err != nil {
+		return err
+	}
+	name := temporary.Name()
+	defer os.Remove(name)
+	if _, err = temporary.Write(contents); err == nil {
+		err = temporary.Sync()
+	}
+	if closeErr := temporary.Close(); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	return os.Rename(name, r.path)
+}
diff --git a/pkg/sink/preparation_manifest_test.go b/pkg/sink/preparation_manifest_test.go
new file mode 100644
index 0000000..6b84611
--- /dev/null
+++ b/pkg/sink/preparation_manifest_test.go
@@ -0,0 +1,91 @@
+package sink
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/rand"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func renderPreparationManifest(t *testing.T, seed int64) ([]byte, preparationManifest) {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "manifest.json")
+	finish, err := StartPreparationManifest(path, seed, "2024-01-01 00:00:00", 1)
+	if err != nil {
+		t.Fatalf("start manifest: %v", err)
+	}
+	random := rand.New(rand.NewSource(seed))
+	for sequence := 0; sequence < 4; sequence++ {
+		statement := fmt.Sprintf(
+			"INSERT INTO t VALUES (%d, %d)", sequence, random.Int63(),
+		)
+		if err := recordPreparationStatement(statement, sequence+1); err != nil {
+			t.Fatalf("record statement %d: %v", sequence, err)
+		}
+	}
+	if err := finish(); err != nil {
+		t.Fatalf("finish manifest: %v", err)
+	}
+	contents, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read manifest: %v", err)
+	}
+	var manifest preparationManifest
+	if err := json.Unmarshal(contents, &manifest); err != nil {
+		t.Fatalf("decode manifest: %v", err)
+	}
+	return contents, manifest
+}
+
+func TestPreparationManifestDeterminism(t *testing.T) {
+	firstBytes, first := renderPreparationManifest(t, 41)
+	secondBytes, second := renderPreparationManifest(t, 41)
+	differentBytes, different := renderPreparationManifest(t, 42)
+
+	if string(firstBytes) != string(secondBytes) {
+		t.Fatal("same seed and load time produced different manifests")
+	}
+	if first.OrderedManifestSHA256 != second.OrderedManifestSHA256 {
+		t.Fatal("same seed produced different ordered manifest hashes")
+	}
+	if string(firstBytes) == string(differentBytes) {
+		t.Fatal("different seeds produced identical manifests")
+	}
+	if first.OrderedManifestSHA256 == different.OrderedManifestSHA256 {
+		t.Fatal("different seeds produced identical ordered manifest hashes")
+	}
+}
+
+func TestPreparationManifestRequiresFixedSingleWorker(t *testing.T) {
+	tests := []struct {
+		name     string
+		path     string
+		seed     int64
+		loadTime string
+		workers  int
+	}{
+		{name: "path", seed: 1, loadTime: "2024-01-01 00:00:00", workers: 1},
+		{name: "seed", path: "manifest.json", loadTime: "2024-01-01 00:00:00", workers: 1},
+		{name: "load time", path: "manifest.json", seed: 1, workers: 1},
+		{name: "worker count", path: "manifest.json", seed: 1, loadTime: "2024-01-01 00:00:00", workers: 2},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			path := test.path
+			if path != "" {
+				path = filepath.Join(t.TempDir(), path)
+			}
+			finish, err := StartPreparationManifest(path, test.seed, test.loadTime, test.workers)
+			if err == nil {
+				_ = finish()
+				t.Fatal("invalid deterministic preparation configuration succeeded")
+			}
+			if !strings.Contains(err.Error(), "one worker") {
+				t.Fatalf("unexpected guard error: %v", err)
+			}
+		})
+	}
+}
