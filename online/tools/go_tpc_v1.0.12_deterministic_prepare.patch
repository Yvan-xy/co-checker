index 0000000..e3bbcfb
--- /dev/null
+++ b/tpcc/workload_deterministic_test.go
@@ -0,0 +1,98 @@
+package tpcc
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+func deterministicTestConfig() Config {
+	return Config{
+		Threads:         1,
+		Parts:           1,
+		PartitionType:   PartitionTypeHash,
+		Warehouses:      1,
+		Weight:          []int{45, 43, 4, 4, 4},
+		OutputType:      "csv",
+		PrepareSeed:     41,
+		PrepareLoadTime: "2024-01-01 00:00:00",
+		PrepareManifest: "manifest.json",
+	}
+}
+
+func TestDeterministicPreparationConfigurationGuards(t *testing.T) {
+	tests := []struct {
+		name      string
+		mutate    func(*Config)
+		wantError string
+	}{
+		{
+			name:      "seed",
+			mutate:    func(config *Config) { config.PrepareSeed = 0 },
+			wantError: "nonzero seed",
+		},
+		{
+			name:      "load time",
+			mutate:    func(config *Config) { config.PrepareLoadTime = "" },
+			wantError: "fixed load time",
+		},
+		{
+			name:      "worker count",
+			mutate:    func(config *Config) { config.Threads = 2 },
+			wantError: "exactly one worker",
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			config := deterministicTestConfig()
+			test.mutate(&config)
+			_, err := NewWorkloader(nil, &config)
+			if err == nil || !strings.Contains(err.Error(), test.wantError) {
+				t.Fatalf("got error %v, want one containing %q", err, test.wantError)
+			}
+		})
+	}
+
+	config := deterministicTestConfig()
+	workload, err := NewWorkloader(nil, &config)
+	if err != nil {
+		t.Fatalf("valid deterministic configuration failed: %v", err)
+	}
