+package main
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/go-sql-driver/mysql"
+)
+
+func TestIsContinuedWriteConflict(t *testing.T) {
+	writeConflict := &mysql.MySQLError{
+		Number:  continuedWriteConflictCode,
+		Message: "Write conflict",
+	}
+	if !isContinuedWriteConflict(writeConflict) {
+		t.Fatal("typed Error 9007 was not accepted")
+	}
+	if !isContinuedWriteConflict(fmt.Errorf("commit failed: %w", writeConflict)) {
+		t.Fatal("wrapped typed Error 9007 was not accepted")
+	}
+	if isContinuedWriteConflict(&mysql.MySQLError{
+		Number:  1062,
+		Message: "Duplicate entry",
+	}) {
+		t.Fatal("non-9007 MySQL error was accepted")
+	}
+	if isContinuedWriteConflict(errors.New(
+		"Error 9007 (HY000): Write conflict",
+	)) {
+		t.Fatal("untyped error text was accepted")
+	}
+	if isContinuedWriteConflict(nil) {
+		t.Fatal("nil error was accepted")
+	}
+}

